{
  "name": "todoboarddesktop",
  "version": "4.0.2",
  "description": "Todo Board Studio - Sleek Kanban Board & Project Management Desktop App",
  "author": "zViiX123",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/zViiX123/Todo_WebApp.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:installer": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.todoboard.desktop",
    "productName": "Todo Board Studio",
    "icon": "build/icon.ico",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Todo Board Studio",
      "installerIcon": "build/installerIcon.ico",
      "uninstallerIcon": "build/uninstallerIcon.ico",
      "uninstallDisplayName": "Todo Board Studio"
    }
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^26.15.3"
  }
}
