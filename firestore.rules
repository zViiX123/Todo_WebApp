rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User data is strictly private to the authenticated owner
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Subcollections under a user's workspace (e.g. data/workspaces, backups, etc.)
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: false;
    }
  }
}
